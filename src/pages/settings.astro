---
import Base from '../layouts/Base.astro';
---
<Base title="" description="" showHeader={true}>
  <a id="top"></a>
  <article class="page settings-page">

    <!-- ───── Auth (above tabs) ───── -->
    <section id="auth-section" class="settings-section auth-bar">
      <div class="road-closed" role="img" aria-label="Access required">
        <div class="road-closed__panel">Road Closed</div>
      </div>
      <div id="auth-prompt" class="auth-bar__prompt">
        <div class="row">
          <label for="pat-input" class="visually-hidden">Access token</label>
          <input type="password" id="pat-input" placeholder="Access token" autocomplete="off" spellcheck="false" />
          <button id="connect-btn" class="btn btn-primary">Submit</button>
        </div>
        <p id="auth-status" class="status"></p>
      </div>
      <div id="auth-status-bar" class="auth-bar__connected" hidden>
        <span>Connected as <strong id="auth-user">…</strong></span>
        <button id="disconnect-btn" class="btn btn-secondary">Disconnect</button>
      </div>
    </section>

    <!-- ───── Tab bar (hidden until connected) ───── -->
    <nav id="tab-bar" class="tab-bar" hidden role="tablist">
      <button class="tab-btn is-active" data-tab="list-editor" role="tab" aria-selected="true">📝 List editor</button>
      <button class="tab-btn" data-tab="list-links" role="tab" aria-selected="false">🔗 List links</button>
      <button class="tab-btn" data-tab="photos" role="tab" aria-selected="false">📷 Photos</button>
    </nav>

    <!-- ───── Panels container (hidden until connected) ───── -->
    <div id="tabs-root" hidden>

      <!-- Panel: List editor (default tab) -->
      <section id="panel-list-editor" class="tab-panel is-active" data-tab-panel="list-editor" role="tabpanel">
        <p class="tab-intro">Mark items done or edit their title. Blank text hides the item from the public list.</p>
        <div class="list-editor-toolbar">
          <button id="add-item-btn" class="btn btn-primary">➕ Add item</button>
          <span class="hint">Auto-fills the lowest missing NN (90, 91, …).</span>
          <span id="add-item-status" class="status"></span>
        </div>
        <div class="pagination" id="list-pagination-top"></div>
        <div id="list-editor" class="list-editor"></div>
        <div class="pagination" id="list-pagination-bottom"></div>
      </section>

      <!-- Panel: List links -->
      <section id="panel-list-links" class="tab-panel" data-tab-panel="list-links" role="tabpanel" hidden>
        <p class="tab-intro">Link each checked item to one photo. Visitors clicking that item will deep-link to the photo in the gallery lightbox.</p>
        <div id="bucket-links" class="bucket-links"></div>
      </section>

      <!-- Panel: Photos -->
      <section id="panel-photos" class="tab-panel" data-tab-panel="photos" role="tabpanel" hidden>
        <p class="tab-intro">Add, edit, or remove photos. Each photo can be linked to a checked bucket list item.</p>
        <div id="photos-list" class="photo-list"></div>
        <details class="add-photo">
          <summary>➕ Add a new photo</summary>
          <div class="add-photo__form">
            <div class="row">
              <label>Image file
                <input type="file" id="new-photo-file" accept="image/*" />
              </label>
            </div>
            <div id="new-photo-preview" class="preview"></div>
            <div class="row">
              <label>Date
                <input type="date" id="new-photo-date" />
              </label>
              <label>Location
                <input type="text" id="new-photo-location" placeholder="Tokyo" />
              </label>
            </div>
            <div class="row">
              <label class="grow">Caption
                <input type="text" id="new-photo-caption" placeholder="Cherry blossoms in Ueno park" />
              </label>
            </div>
            <div class="row">
              <button id="add-photo-btn" class="btn btn-primary" disabled>Upload &amp; commit</button>
              <span id="add-photo-status" class="status"></span>
            </div>
          </div>
        </details>
      </section>

    </div>
  </article>
</Base>

<script>
import {
  verifyPat, setPat, getPat, clearPat,
  getFile, putFile, putBinaryFile, deleteFile, getBinaryFileSha,
  parseGallery, serialiseGallery, parseList, serialiseList,
  processImage, formatBytes,
  type GalleryItem, type BucketItem, type GithubFile,
} from '../lib/settingsClient';

// ───── State ─────
let pat = '';
let gallery: GalleryItem[] = [];
let listItems: BucketItem[] = [];
let galleryFile: GithubFile | null = null;
let listFile: GithubFile | null = null;

const PAGE_SIZE = 10;
let currentListPage = 0;

// ───── DOM refs ─────
const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

const patInput = $<HTMLInputElement>('pat-input');
const connectBtn = $('connect-btn');
const disconnectBtn = $('disconnect-btn');
const authStatus = $('auth-status');
const authPrompt = $('auth-prompt');
const authStatusBar = $('auth-status-bar');
const authUser = $('auth-user');
const tabBar = $('tab-bar');
const tabsRoot = $('tabs-root');
const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('.tab-panel'));
const photosList = $('photos-list');
const bucketLinks = $('bucket-links');
const listEditor = $('list-editor');
const addItemBtn = $<HTMLButtonElement>('add-item-btn');
const addItemStatus = $('add-item-status');
const listPaginationTop = $('list-pagination-top');
const listPaginationBottom = $('list-pagination-bottom');

// ───── Auth ─────
async function tryAutoReconnect() {
  const existing = getPat();
  if (!existing) return;
  patInput.value = '••••••••••••••••'; // show placeholder, don't reveal
  pat = existing;
  const result = await verifyPat(pat);
  if (result.ok) {
    onAuthenticated(result.user ?? 'unknown');
  } else {
    clearPat();
    patInput.value = '';
    setAuthStatus(`Previous token invalid: ${result.error}. Please reconnect.`, true);
  }
}

async function connect() {
  const entered = patInput.value.trim();
  if (!entered) {
    setAuthStatus('Please paste a token.', true);
    return;
  }
  setAuthStatus('Verifying…');
  const result = await verifyPat(entered);
  if (!result.ok) {
    setAuthStatus('Token rejected.', true);
    return;
  }
  pat = entered;
  setPat(pat);
  patInput.value = '••••••••••••••••';
  onAuthenticated(result.user ?? 'unknown');
}

function disconnect() {
  pat = '';
  clearPat();
  patInput.value = '';
  setAuthStatus('Disconnected.');
  authPrompt.hidden = false;
  authStatusBar.hidden = true;
  tabBar.hidden = true;
  tabsRoot.hidden = true;
  connectBtn.hidden = false;
  disconnectBtn.hidden = true;
}

function onAuthenticated(user: string) {
  authUser.textContent = user;
  authPrompt.hidden = true;
  authStatusBar.hidden = false;
  tabBar.hidden = false;
  tabsRoot.hidden = false;
  connectBtn.hidden = true;
  disconnectBtn.hidden = false;
  loadAll().catch((e) => setAuthStatus(`Load failed: ${e}`, true));
}

function setAuthStatus(msg: string, isError = false) {
  authStatus.textContent = msg;
  authStatus.className = `status ${isError ? 'status-error' : 'status-ok'}`;
}

// ───── Tabs ─────
function showTab(name: string) {
  for (const btn of tabBtns) {
    const active = btn.dataset.tab === name;
    btn.classList.toggle('is-active', active);
    btn.setAttribute('aria-selected', String(active));
  }
  for (const panel of tabPanels) {
    const active = panel.dataset.tabPanel === name;
    panel.classList.toggle('is-active', active);
    panel.hidden = !active;
  }
}
for (const btn of tabBtns) {
  btn.addEventListener('click', () => showTab(btn.dataset.tab ?? ''));
}

connectBtn.addEventListener('click', connect);
disconnectBtn.addEventListener('click', disconnect);
patInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') connect();
});

// ───── Load all data ─────
async function loadAll() {
  await Promise.all([loadGallery(), loadList()]);
  renderPhotos();
  renderBucketLinks();
  renderListEditor();
}

async function loadGallery() {
  const file = await getFile('data/gallery.env', pat);
  if (!file) throw new Error('Could not read data/gallery.env');
  galleryFile = file;
  gallery = parseGallery(file.content);
}

async function loadList() {
  const file = await getFile('data/list.env', pat);
  if (!file) throw new Error('Could not read data/list.env');
  listFile = file;
  listItems = parseList(file.content);
}

// ───── Render photos ─────
function renderPhotos() {
  photosList.innerHTML = '';
  for (const p of gallery) {
    const row = document.createElement('div');
    row.className = 'photo-row';
    row.dataset.num = p.num;
    row.innerHTML = `
      <img class="photo-thumb" src="${escapeAttr(p.url)}" alt="" loading="lazy" />
      <div class="photo-fields">
        <div class="row">
          <label>ID
            <input type="text" class="p-num" value="${escapeAttr(p.num)}" readonly />
          </label>
          <label>Date
            <input type="date" class="p-date" value="${escapeAttr(p.date)}" />
          </label>
        </div>
        <label class="grow">Location
          <input type="text" class="p-loc" value="${escapeAttr(p.location)}" />
        </label>
        <label class="grow">Caption
          <input type="text" class="p-cap" value="${escapeAttr(p.caption)}" />
        </label>
        <label class="grow url">URL
          <input type="text" class="p-url" value="${escapeAttr(p.url)}" />
        </label>
        <div class="row actions">
          <button class="btn btn-primary p-save">Save metadata</button>
          <button class="btn btn-danger p-delete">Delete photo</button>
          <span class="status p-status"></span>
        </div>
      </div>
    `;
    photosList.appendChild(row);

    row.querySelector('.p-save')!.addEventListener('click', () => savePhoto(p.num));
    row.querySelector('.p-delete')!.addEventListener('click', () => deletePhoto(p.num));
  }
}

async function savePhoto(num: string) {
  const row = photosList.querySelector<HTMLElement>(`.photo-row[data-num="${num}"]`)!;
  const newDate = row.querySelector<HTMLInputElement>('.p-date')!.value;
  const newLoc = row.querySelector<HTMLInputElement>('.p-loc')!.value;
  const newCap = row.querySelector<HTMLInputElement>('.p-cap')!.value;
  const newUrl = row.querySelector<HTMLInputElement>('.p-url')!.value;
  const status = row.querySelector<HTMLElement>('.p-status')!;

  const item = gallery.find((g) => g.num === num);
  if (!item) return;
  item.date = newDate;
  item.location = newLoc;
  item.caption = newCap;
  item.url = newUrl;

  status.textContent = 'Saving…';
  status.className = 'status';
  try {
    const content = serialiseGallery(gallery, galleryFile ? extractHeader(galleryFile.content) : '');
    const newSha = await putFile(
      'data/gallery.env',
      content,
      galleryFile!.sha,
      `gallery: update metadata for photo ${num}`,
      pat,
    );
    galleryFile = { path: 'data/gallery.env', content, sha: newSha };
    status.textContent = '✓ Saved';
    status.className = 'status status-ok';
    renderBucketLinks(); // refresh photo dropdowns in case locations changed
  } catch (e) {
    status.textContent = `✗ ${String(e)}`;
    status.className = 'status status-error';
  }
}

async function deletePhoto(num: string) {
  const item = gallery.find((g) => g.num === num);
  if (!item) return;
  if (!confirm(`Delete photo ${num} (${item.caption || item.location})?\n\nThis also unlinks it from any bucket item.`)) return;

  // Unlink from any bucket item
  let listChanged = false;
  for (const li of listItems) {
    if (li.photo === num) {
      li.photo = '';
      listChanged = true;
    }
  }

  const status = photosList.querySelector<HTMLElement>(`.photo-row[data-num="${num}"] .p-status`)!;
  status.textContent = 'Deleting…';
  try {
    // Delete the image file (if it's in the repo)
    if (item.url.startsWith('/')) {
      const imagePath = `public${item.url}`;
      try {
        const sha = await getBinaryFileSha(imagePath, pat);
        if (sha) await deleteFile(imagePath, sha, `gallery: remove photo ${num}`, pat);
      } catch (e) {
        // image may not exist; that's OK
      }
    }
    // Update gallery.env
    gallery = gallery.filter((g) => g.num !== num);
    const newContent = serialiseGallery(gallery, galleryFile ? extractHeader(galleryFile.content) : '');
    galleryFile = await getFile('data/gallery.env', pat); // refresh sha
    const newSha = await putFile(
      'data/gallery.env',
      newContent,
      galleryFile!.sha,
      `gallery: remove photo ${num}`,
      pat,
    );
    galleryFile = { path: 'data/gallery.env', content: newContent, sha: newSha };
    // Update list.env if needed
    if (listChanged) {
      listFile = await getFile('data/list.env', pat);
      const listContent = serialiseList(listItems);
      const listSha = await putFile('data/list.env', listContent, listFile!.sha, `list: unlink photo ${num}`, pat);
      listFile = { path: 'data/list.env', content: listContent, sha: listSha };
    }
    status.textContent = '✓ Deleted';
    renderPhotos();
    renderBucketLinks();
  } catch (e) {
    status.textContent = `✗ ${String(e)}`;
  }
}

// ───── Add new photo ─────
const newPhotoFile = $<HTMLInputElement>('new-photo-file');
const newPhotoDate = $<HTMLInputElement>('new-photo-date');
const newPhotoLocation = $<HTMLInputElement>('new-photo-location');
const newPhotoCaption = $<HTMLInputElement>('new-photo-caption');
const newPhotoPreview = $('new-photo-preview');
const addPhotoBtn = $('add-photo-btn') as HTMLButtonElement;
const addPhotoStatus = $('add-photo-status');

let processedImage: { blob: Blob; width: number; height: number; base64: string } | null = null;

newPhotoFile.addEventListener('change', async () => {
  const file = newPhotoFile.files?.[0];
  if (!file) return;
  addPhotoStatus.textContent = 'Processing…';
  try {
    processedImage = await processImage(file);
    const sizeKB = formatBytes(processedImage.blob.size);
    newPhotoPreview.innerHTML = `
      <div class="preview__info">
        ✓ ${processedImage.width}×${processedImage.height}px · ${sizeKB} · WebP
      </div>
      <img class="preview__img" alt="Preview" />
    `;
    (newPhotoPreview.querySelector('.preview__img') as HTMLImageElement).src =
      URL.createObjectURL(processedImage.blob);
    addPhotoBtn.disabled = false;
    addPhotoStatus.textContent = '';
    // Default date to today
    if (!newPhotoDate.value) {
      newPhotoDate.value = new Date().toISOString().slice(0, 10);
    }
  } catch (e) {
    addPhotoStatus.textContent = `✗ ${String(e)}`;
    addPhotoBtn.disabled = true;
    processedImage = null;
  }
});

addPhotoBtn.addEventListener('click', async () => {
  if (!processedImage) return;
  const date = newPhotoDate.value || new Date().toISOString().slice(0, 10);
  const location = newPhotoLocation.value.trim();
  const caption = newPhotoCaption.value.trim();
  if (!location) {
    addPhotoStatus.textContent = '✗ Location is required.';
    return;
  }
  if (!caption) {
    addPhotoStatus.textContent = '✗ Caption is required.';
    return;
  }

  // Allocate next id
  const used = gallery.map((g) => parseInt(g.num, 10)).filter(Number.isFinite);
  const nextId = used.length === 0 ? 1 : Math.max(...used) + 1;
  const num = String(nextId).padStart(2, '0');
  const filename = `${num}.webp`;
  const url = `/images/gallery/${filename}`;
  const imagePath = `public${url}`;

  addPhotoBtn.disabled = true;
  addPhotoStatus.textContent = 'Committing…';

  try {
    // 1. Upload image
    await putBinaryFile(imagePath, processedImage.base64, null, `gallery: upload photo ${num}`, pat);

    // 2. Update gallery.env
    gallery.push({ num, id: nextId, date, location, caption, url });
    gallery.sort((a, b) => (a.date < b.date ? 1 : -1));
    const newContent = serialiseGallery(gallery, galleryFile ? extractHeader(galleryFile.content) : '');
    galleryFile = await getFile('data/gallery.env', pat);
    await putFile('data/gallery.env', newContent, galleryFile!.sha, `gallery: add photo ${num} (${caption})`, pat);

    // Refresh SHA
    galleryFile = { path: 'data/gallery.env', content: newContent, sha: (await getFile('data/gallery.env', pat))!.sha };

    addPhotoStatus.textContent = `✓ Uploaded as photo ${num}. Deploying…`;
    newPhotoFile.value = '';
    newPhotoLocation.value = '';
    newPhotoCaption.value = '';
    newPhotoDate.value = '';
    newPhotoPreview.innerHTML = '';
    processedImage = null;
    renderPhotos();
    renderBucketLinks();
  } catch (e) {
    addPhotoStatus.textContent = `✗ ${String(e)}`;
  } finally {
    addPhotoBtn.disabled = false;
  }
});

// ───── Bucket list links ─────
function renderBucketLinks() {
  bucketLinks.innerHTML = '';
  const checked = listItems.filter((li) => li.checked);
  if (checked.length === 0) {
    bucketLinks.innerHTML = '<p class="status">No checked items yet. Edit data/list.env and mark items checked there.</p>';
    return;
  }
  for (const li of checked) {
    const row = document.createElement('div');
    row.className = 'bucket-row';
    row.dataset.num = li.num;

    const opts = gallery
      .map((g) => `<option value="${escapeAttr(g.num)}" ${g.num === li.photo ? 'selected' : ''}>${escapeHtml(g.num)} · ${escapeHtml(g.caption || g.location)}</option>`)
      .join('');

    row.innerHTML = `
      <span class="bucket-num">${escapeHtml(li.num)}.</span>
      <span class="bucket-text">${escapeHtml(li.text)}</span>
      <select class="bucket-photo">
        <option value="">— none —</option>
        ${opts}
      </select>
      <button class="btn btn-primary bucket-save">Save</button>
      <span class="status bucket-status"></span>
    `;
    bucketLinks.appendChild(row);

    row.querySelector('.bucket-save')!.addEventListener('click', () => saveBucketLink(li.num));
  }
}

async function saveBucketLink(num: string) {
  const row = bucketLinks.querySelector<HTMLElement>(`.bucket-row[data-num="${num}"]`)!;
  const newPhoto = row.querySelector<HTMLSelectElement>('.bucket-photo')!.value;
  const status = row.querySelector<HTMLElement>('.bucket-status')!;

  const li = listItems.find((x) => x.num === num);
  if (!li) return;
  li.photo = newPhoto;

  status.textContent = 'Saving…';
  status.className = 'status';
  try {
    listFile = await getFile('data/list.env', pat);
    const content = serialiseList(listItems);
    const sha = await putFile('data/list.env', content, listFile!.sha, `list: link item ${num} to photo ${newPhoto || '(unlink)'}`, pat);
    listFile = { path: 'data/list.env', content, sha };
    status.textContent = '✓ Saved';
    status.className = 'status status-ok';
  } catch (e) {
    status.textContent = `✗ ${String(e)}`;
    status.className = 'status status-error';
  }
}

// ───── Bucket list editor ─────
function nextMissingNN(): number {
  const used = new Set(listItems.map((li) => li.id));
  // Fill gaps 0..99 first, then overflow to 100+.
  for (let n = 0; n <= 99; n++) {
    if (!used.has(n)) return n;
  }
  let n = 100;
  while (used.has(n)) n++;
  return n;
}

function renderListEditor() {
  // Show ALL items sorted by NN — including blank-text rows, so they can be
  // edited later. The public list still omits blank-text rows.
  const sorted = [...listItems].sort((a, b) => a.id - b.id);

  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
  // Clamp page in case the list shrank.
  if (currentListPage >= totalPages) currentListPage = totalPages - 1;
  if (currentListPage < 0) currentListPage = 0;
  const start = currentListPage * PAGE_SIZE;
  const pageItems = sorted.slice(start, start + PAGE_SIZE);

  const paginationHtml = renderPagination(totalPages, sorted.length);
  listPaginationTop.innerHTML = paginationHtml;
  listPaginationBottom.innerHTML = paginationHtml;

  listEditor.innerHTML = '';
  if (pageItems.length === 0) {
    listEditor.innerHTML = '<p class="status">No items to show. Click "➕ Add item" above to start.</p>';
    return;
  }

  for (const li of pageItems) {
    const row = document.createElement('div');
    row.className = 'list-editor-row';
    row.dataset.num = li.num;

    row.innerHTML = `
      <input type="checkbox" class="le-check" ${li.checked ? 'checked' : ''} aria-label="Done" />
      <span class="le-num">${escapeHtml(li.num)}</span>
      <input type="text" class="le-text" value="${escapeAttr(li.text)}" placeholder="(blank hides the item from the public site)" />
      <button class="btn btn-primary le-save">Save</button>
      <span class="status le-status"></span>
    `;
    listEditor.appendChild(row);

    row.querySelector('.le-save')!.addEventListener('click', () => saveListItem(li.num));
  }

  wirePagination();
}

function renderPagination(totalPages: number, totalItems: number): string {
  const page1 = currentListPage + 1;
  const first = currentListPage * PAGE_SIZE + 1;
  const last = Math.min((currentListPage + 1) * PAGE_SIZE, totalItems);
  return `
    <button class="btn btn-secondary page-prev" ${currentListPage === 0 ? 'disabled' : ''}>← Prev</button>
    <span class="page-indicator">Page <strong>${page1}</strong> of ${totalPages} <span class="muted">(items ${first}–${last} of ${totalItems})</span></span>
    <button class="btn btn-secondary page-next" ${currentListPage >= totalPages - 1 ? 'disabled' : ''}>Next →</button>
  `;
}

function wirePagination() {
  for (const el of document.querySelectorAll<HTMLButtonElement>('.page-prev')) {
    el.addEventListener('click', () => { if (currentListPage > 0) { currentListPage--; renderListEditor(); } });
  }
  for (const el of document.querySelectorAll<HTMLButtonElement>('.page-next')) {
    el.addEventListener('click', () => { currentListPage++; renderListEditor(); });
  }
}

async function saveListItem(num: string) {
  const row = listEditor.querySelector<HTMLElement>(`.list-editor-row[data-num="${num}"]`);
  if (!row) return;
  const newText = row.querySelector<HTMLInputElement>('.le-text')!.value.trim();
  const newChecked = row.querySelector<HTMLInputElement>('.le-check')!.checked;
  const status = row.querySelector<HTMLElement>('.le-status')!;

  const li = listItems.find((x) => x.num === num);
  if (!li) return;
  const wasChecked = li.checked;
  const wasText = li.text;
  li.text = newText;
  li.checked = newChecked;

  status.textContent = 'Saving…';
  status.className = 'status';
  try {
    listFile = await getFile('data/list.env', pat);
    const content = serialiseList(listItems);
    const sha = await putFile('data/list.env', content, listFile!.sha, `list: update item ${num}`, pat);
    listFile = { path: 'data/list.env', content, sha };
    status.textContent = '✓ Saved';
    status.className = 'status status-ok';

    // If checked state changed, refresh the list-links tab (it only shows checked items).
    if (wasChecked !== newChecked) renderBucketLinks();
  } catch (e) {
    // Revert in-memory change so the UI matches the on-disk truth.
    li.text = wasText;
    li.checked = wasChecked;
    status.textContent = `✗ ${String(e)}`;
    status.className = 'status status-error';
  }
}

async function addListItem() {
  const newId = nextMissingNN();
  const newItem: BucketItem = {
    num: String(newId).padStart(2, '0'),
    id: newId,
    text: '',
    checked: false,
    link: '',
    photo: '',
  };
  listItems.push(newItem);

  addItemStatus.textContent = 'Adding…';
  addItemStatus.className = 'status';
  addItemBtn.disabled = true;
  try {
    listFile = await getFile('data/list.env', pat);
    const content = serialiseList(listItems);
    const sha = await putFile('data/list.env', content, listFile!.sha, `list: add item ${newItem.num}`, pat);
    listFile = { path: 'data/list.env', content, sha };
    addItemStatus.textContent = `✓ Added item ${newItem.num}`;
    addItemStatus.className = 'status status-ok';

    // Jump to the page containing the new item, then render.
    currentListPage = Math.floor((listItems.length - 1) / PAGE_SIZE);
    renderListEditor();
  } catch (e) {
    // Roll back the in-memory addition.
    listItems = listItems.filter((li) => li.id !== newId);
    addItemStatus.textContent = `✗ ${String(e)}`;
    addItemStatus.className = 'status status-error';
  } finally {
    addItemBtn.disabled = false;
  }
}

addItemBtn.addEventListener('click', () => addListItem().catch((e) => {
  addItemStatus.textContent = `✗ ${String(e)}`;
}));

// ───── Helpers ─────
function extractHeader(content: string): string {
  const lines = content.split('\n');
  const headerLines: string[] = [];
  for (const line of lines) {
    if (line.startsWith('#') || line.trim() === '') {
      headerLines.push(line);
    } else {
      break;
    }
  }
  return headerLines.join('\n');
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function escapeAttr(s: string): string {
  return escapeHtml(s);
}

// ───── Boot ─────
tryAutoReconnect();
</script>

