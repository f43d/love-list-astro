---
/* Home page — the main bucket list. Pure route shell: it wraps the
   shared <Base> layout and the <BucketList> component (which loads and
   renders data/list.env). Everything else lives in those two files. */
import Base from '../layouts/Base.astro';
import BucketList from '../components/BucketList.astro';
---
<Base title="" showHeader={true}>
  <a id="top"></a>
  <BucketList />
</Base>