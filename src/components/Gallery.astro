---
import { loadGallerySorted, type GalleryItem } from '../lib/parseGallery';

interface Props {
  items?: GalleryItem[];
}
const items = (Astro.props as Props).items ?? loadGallerySorted();
---
<section class="gallery" id="gallery" aria-label="Photo gallery">
  <ol class="gallery__list" role="list">
    {items.map((img, i) => (
      <li class="gallery__item" id={`photo-${img.num}`}>
        <button
          class="gallery__thumb"
          type="button"
          data-index={i}
          data-num={img.num}
          aria-label={`Open photo ${img.num}: ${img.caption || img.location}`}
        >
          <img
            src={img.url}
            alt={img.caption || `${img.location} photo`}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
        <figcaption class="gallery__caption">
          <span class="gallery__caption-loc">{img.location}</span>
          {img.caption && (
            <>
              <span class="gallery__caption-sep" aria-hidden="true">·</span>
              <span class="gallery__caption-text">{img.caption}</span>
            </>
          )}
          <span class="gallery__caption-date">{img.date}</span>
        </figcaption>
      </li>
    ))}
  </ol>
</section>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <button class="lightbox__close" type="button" aria-label="Close">×</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photo">‹</button>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photo">›</button>
  <figure class="lightbox__figure">
    <img id="lightbox-img" alt="" />
    <figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
  </figure>
</dialog>

<script id="gallery-data" type="application/json" set:html={JSON.stringify(items)} />

<script>
  type GalleryItem = {
    num: string;
    date: string;
    location: string;
    caption: string;
    url: string;
  };

  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const dialogImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const dialogCaption = document.getElementById('lightbox-caption') as HTMLElement | null;
  const closeBtn = dialog?.querySelector('.lightbox__close') as HTMLButtonElement | null;
  const prevBtn = dialog?.querySelector('.lightbox__nav--prev') as HTMLButtonElement | null;
  const nextBtn = dialog?.querySelector('.lightbox__nav--next') as HTMLButtonElement | null;

  if (!dialog || !dialogImg || !dialogCaption) {
    // Lightbox markup missing — bail.
  } else {
    // Read items from the JSON blob rendered by Astro. No DOM querying
    // required — captions cannot get out of sync with photos.
    const dataEl = document.getElementById('gallery-data') as HTMLScriptElement | null;
    let items: GalleryItem[] = [];
    try {
      items = dataEl ? (JSON.parse(dataEl.textContent ?? '[]') as GalleryItem[]) : [];
    } catch {
      items = [];
    }

    function renderCaption(it: GalleryItem): string {
      const parts: string[] = [];
      if (it.location) parts.push(escapeHtml(it.location));
      if (it.caption) {
        if (parts.length) parts.push('<span class="lightbox__caption-sep" aria-hidden="true">·</span>');
        parts.push('<em>' + escapeHtml(it.caption) + '</em>');
      }
      if (it.date) {
        parts.push('<span class="lightbox__caption-date">' + escapeHtml(it.date) + '</span>');
      }
      return parts.join(' ');
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    let current = 0;

    function render(idx: number): void {
      if (!items.length) return;
      current = ((idx % items.length) + items.length) % items.length;
      const it = items[current];
      dialogImg.src = it.url;
      dialogImg.alt = it.caption || it.location || `Photo ${it.num}`;
      dialogCaption.innerHTML = renderCaption(it);
      history.replaceState(null, '', `#${it.num}`);
    }

    function open(idx: number): void {
      render(idx);
      dialog?.showModal();
    }

    function close(): void {
      dialog?.close();
      history.replaceState(null, '', ' ');
    }

    document.querySelectorAll<HTMLButtonElement>('.gallery__thumb').forEach((btn, idx) => {
      btn.addEventListener('click', () => open(idx));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => render(current - 1));
    nextBtn?.addEventListener('click', () => render(current + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') render(current - 1);
      else if (e.key === 'ArrowRight') render(current + 1);
    });

    // Touch swipe
    let touchStartX = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0]?.clientX ?? 0;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? 0) - touchStartX;
      if (Math.abs(dx) > 50) render(current + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Deep-link from URL fragment on page load
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const idx = items.findIndex((it) => it.num === hash);
      if (idx >= 0) open(idx);
    }

    // React to hashchange
    window.addEventListener('hashchange', () => {
      const h = window.location.hash.replace('#', '');
      const idx = items.findIndex((it) => it.num === h);
      if (idx >= 0) open(idx);
    });
  }
</script>