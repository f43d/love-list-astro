---
import { loadListSorted } from '../lib/parseList';

const items = loadListSorted();

function pickRandomInt(max: number): number {
  return 1 + Math.floor(Math.random() * max);
}
---
<section class="bucket-list" aria-label="Bucket list">
  {items.map((item, i) => {
    const checkNum = pickRandomInt(4);
    const variant = i % 4 + 1;
    const checkSrc = item.checked
      ? `/svg/checkboxes/checked${checkNum}.svg`
      : `/svg/checkboxes/unchecked${variant}.svg`;

    // Decide link target.
    // - checked + has photo id  → deep-link to gallery lightbox (`/gallery/#NN`)
    // - has external link       → that link
    // - placeholder link         → own anchor (no surprise 404s)
    // - otherwise                → own anchor
    let href = `#item-${item.num}`;
    let isExternal = false;
    if (item.checked && item.photo) {
      href = `/gallery/#${item.photo}`;
    } else if (item.link && item.link !== 'https://example.com') {
      href = item.link;
      isExternal = href.startsWith('http');
    }

    return (
      <div class={`list-item${item.checked ? ' is-checked' : ''}`} id={`item-${item.num}`}>
        <img class="list-item__check" src={checkSrc} alt="" width="48" height="48" loading="lazy" />
        <span class="list-item__check-spacer" aria-hidden="true"></span>
        <span class="list-item__num">{item.num}.</span>
        <span class="list-item__num-spacer" aria-hidden="true"></span>
        <a
          class={`list-item__text${item.checked && item.photo ? ' list-item__text--has-photo' : ''}`}
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >{item.text}</a>
        {item.checked && item.photo && (
          <span class="list-item__photo-icon" aria-hidden="true">📷</span>
        )}
      </div>
    );
  })}
</section>