---
import { loadListSorted } from '../lib/parseList';
import { loadVideos } from '../lib/parseVideos';
import { pickRandomInt } from '../lib/utils';
import type { BucketItem } from '../lib/types';

const items: BucketItem[] = loadListSorted();

// Bucket items that have at least one clip attached (data/videos.env "item"
// column). Their video badge deep-links to the item's group on /video/.
const itemsWithVideos = new Set(loadVideos().map((v) => v.item).filter(Boolean));
---

<!-- The main bucket list. Each item picks one of four checkbox SVG
     variants randomly at build time (so the visual is varied without
     per-item data) and links out to a gallery photo, an external URL,
     or just stays in-place as an anchor depending on what's set. -->
<section class="bucket-list" aria-label="Bucket list">
  {items.map((item, i) => {
    // Pick a random checked/unchecked variant (1..4) for the icon.
    const variant = i % 4 + 1;
    const randomVariant = pickRandomInt(4);
    const checkSrc = item.checked
      ? `/svg/checkboxes/checked${randomVariant}.svg`
      : `/svg/checkboxes/unchecked${variant}.svg`;

    // Decide the link target, in priority order:
    //   1. checked item with a photo id  → /gallery/#photoId (deep-link)
    //   2. has a real external link       → that link
    //   3. placeholder link or empty      → self-anchor (#item-NN)
    let href = `#item-${item.num}`;
    let isExternal = false;
    if (item.checked && item.photo) {
      href = `/gallery/#${item.photo}`;
    } else if (item.link && item.link !== 'https://example.com') {
      href = item.link;
      isExternal = href.startsWith('http');
    }

    return (
      <div class={`list-item${item.checked ? ' is-checked' : ''}`} id={`item-${item.num}`}>
        <img class="list-item__check" src={checkSrc} alt="" width="48" height="48" loading="lazy" />
        <span class="list-item__check-spacer" aria-hidden="true"></span>
        <span class="list-item__num">{item.num}.</span>
        <span class="list-item__num-spacer" aria-hidden="true"></span>
        <a
          class={`list-item__text${item.checked && item.photo ? ' list-item__text--has-photo' : ''}`}
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >{item.text}</a>
                {(item.checked && item.photo) || itemsWithVideos.has(item.num) ? (
          <span class="list-item__badges">
            {item.checked && item.photo && (
              <a
                class="list-item__photo-icon"
                href={`/gallery/#${item.photo}`}
                aria-label={`查看照片 #${item.photo}`}
              >
                <svg viewBox="0 0 192 192" fill="currentColor" aria-hidden="true" width="1em" height="1em"><path fill="currentColor" d="M60 50v6a6 6 0 0 0 4.8-2.4L60 50Zm12-16v-6a6 6 0 0 0-4.8 2.4L72 34Zm60 16-4.8 3.6A6 6 0 0 0 132 56v-6Zm-12-16 4.8-3.6A6 6 0 0 0 120 28v6Zm44 32v76h12V66h-12Zm-10 86H38v12h116v-12ZM28 142V66H16v76h12Zm10-86h22V44H38v12Zm26.8-2.4 12-16-9.6-7.2-12 16 9.6 7.2ZM132 56h22V44h-22v12Zm4.8-9.6-12-16-9.6 7.2 12 16 9.6-7.2ZM120 28H72v12h48V28ZM38 152c-5.523 0-10-4.477-10-10H16c0 12.15 9.85 22 22 22v-12Zm126-10c0 5.523-4.477 10-10 10v12c12.15 0 22-9.85 22-22h-12Zm12-76c0-12.15-9.85-22-22-22v12c5.523 0 10 4.477 10 10h12ZM28 66c0-5.523 4.477-10 10-10V44c-12.15 0-22 9.85-22 22h12Z"/><circle cx="96" cy="102" r="28" fill="none" stroke="currentColor" stroke-width="12"/></svg>
              </a>
            )}
            {itemsWithVideos.has(item.num) && (
              <a
                class="list-item__video-icon"
                href={`/video/#${item.num}`}
                aria-label={`觀看影片 #${item.num}`}
              >
                <svg viewBox="-3 0 32 32" fill="currentColor" aria-hidden="true" width="1em" height="1em"><path fill="currentColor" d="M0 4.985v22.029h26.226v-22.029h-26.226zM4.196 25.966h-3.147v-4.196h3.147v4.196zM4.196 20.721h-3.147v-4.196h3.147v4.196zM4.196 15.476h-3.147v-4.196h3.147v4.196zM4.196 10.231h-3.147v-4.196h3.147v4.196zM20.98 11.979v13.987h-15.735v-19.931h15.735v5.944zM25.177 25.966h-3.147v-4.196h3.147v4.196zM25.177 20.721h-3.147v-4.196h3.147v4.196zM25.177 15.476h-3.147v-4.196h3.147v4.196zM25.177 10.231h-3.147v-4.196h3.147v4.196z"/><path fill="currentColor" d="M10.49 11.76v8.479l7.343-4.239-7.343-4.24zM11.539 13.577l4.196 2.423-4.196 2.423v-4.845z"/></svg>
              </a>
            )}
          </span>
        ) : null}
      </div>
    );
  })}
</section>
