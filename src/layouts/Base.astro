---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = '',
  description = '一百個不結婚的理由，再冠冕堂皇的藉口亦難掩内心的渴求。',
  showHeader = true,
} = Astro.props;

const fullTitle = title ? `${title} · buc.ketli.st` : 'buc.ketli.st';
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#2f5061" />
  <meta name="color-scheme" content="only light" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preload" as="font" href="/fonts/DC-CST.woff2" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" as="font" href="/fonts/awkwardblack.woff2" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" as="font" href="/fonts/wenwrite-subset.woff2" type="font/woff2" crossorigin="anonymous" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="icon" href="/images/profile.jpg" />
  <title>{fullTitle}</title>
</head>
<body>
  {showHeader && <Header />}
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
